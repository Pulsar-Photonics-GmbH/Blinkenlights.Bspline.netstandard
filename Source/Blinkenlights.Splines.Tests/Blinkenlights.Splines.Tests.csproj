<!-- MSTest.Sdk (version pinned in global.json) runs the tests on Microsoft.Testing.Platform and
     brings MSTest, its analyzers and the code coverage and TRX report extensions. -->
<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Blinkenlights.Splines\Blinkenlights.Splines.csproj"/>
    </ItemGroup>

</Project>
